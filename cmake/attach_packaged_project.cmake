# Loaded before NauEngine constructs its target graph.
foreach(suffix SOURCE_DIR ARCHIVE)
  if(NAU_BROWSER_PROJECT_${suffix})
    if(NAU_PACKAGED_PROJECT_${suffix} AND NOT NAU_PACKAGED_PROJECT_${suffix} STREQUAL NAU_BROWSER_PROJECT_${suffix})
      message(FATAL_ERROR "Conflicting NAU_PACKAGED_PROJECT_${suffix} and NAU_BROWSER_PROJECT_${suffix}")
    endif()
    set(NAU_PACKAGED_PROJECT_${suffix} "${NAU_BROWSER_PROJECT_${suffix}}")
  endif()
endforeach()
cmake_path(CONVERT "${NAU_PACKAGED_PROJECT_ARCHIVE}" TO_CMAKE_PATH_LIST NAU_PACKAGED_PROJECT_ARCHIVE NORMALIZE)
if(NOT EXISTS "${NAU_PACKAGED_PROJECT_SOURCE_DIR}/CMakeLists.txt")
  message(FATAL_ERROR "Set NAU_PACKAGED_PROJECT_SOURCE_DIR to the consumer project")
endif()
file(REAL_PATH "${NAU_PACKAGED_PROJECT_SOURCE_DIR}" NAU_PACKAGED_PROJECT_SOURCE_DIR)
set(NAU_PACKAGED_PROJECT_SOURCE_DIR "${NAU_PACKAGED_PROJECT_SOURCE_DIR}" CACHE PATH "Packaged project source directory" FORCE)
if(NOT NAU_PACKAGED_PROJECT_DECLARATION)
  set(NAU_PACKAGED_PROJECT_DECLARATION "${NAU_PACKAGED_PROJECT_SOURCE_DIR}/portable_project.json")
endif()
cmake_path(CONVERT "${NAU_EXTERNAL_PROJECT_DIRS}" TO_CMAKE_PATH_LIST NAU_EXTERNAL_PROJECT_DIRS NORMALIZE)
include("${CMAKE_CURRENT_LIST_DIR}/attach_modules.cmake")
set(NAU_EXTERNAL_RUNTIME_FILE "${CMAKE_CURRENT_LIST_DIR}/NauPackagedProjectRuntime.cmake" CACHE FILEPATH "Packaged runtime configuration" FORCE)
list(APPEND NAU_EXTERNAL_PROJECT_DIRS "${NAU_PACKAGED_PROJECT_SOURCE_DIR}")
list(REMOVE_DUPLICATES NAU_EXTERNAL_PROJECT_DIRS)
set(NAU_EXTERNAL_PROJECT_DIRS "${NAU_EXTERNAL_PROJECT_DIRS}" CACHE STRING "Consumer projects" FORCE)
