include_guard(GLOBAL)
function(nau_read_packaged_project declaration)
  if(NOT EXISTS "${declaration}")
    message(FATAL_ERROR "Missing portable project declaration: ${declaration}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${declaration}")
  file(READ "${declaration}" data)
  foreach(field version profile projectModule startupConfiguration modules supportedComponents)
    string(JSON value ERROR_VARIABLE error GET "${data}" "${field}")
    if(error)
      message(FATAL_ERROR "Invalid portable project declaration ${declaration}: ${field}: ${error}")
    endif()
    set(${field} "${value}")
  endforeach()
  string(JSON kind TYPE "${data}" version)
  if(NOT kind STREQUAL "NUMBER" OR NOT version STREQUAL "1")
    message(FATAL_ERROR "Unsupported portable project declaration version: ${version}")
  endif()
  if(NOT profile STREQUAL "non-rendering-scene")
    message(FATAL_ERROR "Unsupported portable project profile: ${profile}")
  endif()
  if(NOT projectModule MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "Invalid portable project module: ${projectModule}")
  endif()
  if(NOT startupConfiguration MATCHES "^/config/[A-Za-z0-9_-]+\\.json$")
    message(FATAL_ERROR "Invalid portable startup configuration: ${startupConfiguration}")
  endif()
  foreach(field modules supportedComponents)
    string(JSON kind TYPE "${data}" "${field}")
    if(NOT kind STREQUAL "ARRAY")
      message(FATAL_ERROR "Portable declaration ${field} must be an array")
    endif()
    string(JSON count LENGTH "${data}" "${field}")
    if(count LESS 1)
      message(FATAL_ERROR "Portable declaration ${field} must not be empty")
    endif()
    math(EXPR last "${count}-1")
    set(values)
    foreach(index RANGE 0 ${last})
      string(JSON kind TYPE "${data}" "${field}" ${index})
      string(JSON value GET "${data}" "${field}" ${index})
      if(NOT kind STREQUAL "STRING" OR NOT value MATCHES "^[A-Za-z_][A-Za-z0-9_:]*$" OR value IN_LIST values)
        message(FATAL_ERROR "Invalid or duplicate ${field} entry: ${value}")
      endif()
      list(APPEND values "${value}")
    endforeach()
    set(${field} "${values}")
  endforeach()
  set(required PlatformApp CoreAssets CoreScene CoreSceneFormats)
  foreach(module IN LISTS modules)
    if(NOT module IN_LIST required)
      message(FATAL_ERROR "Unsupported portable project module '${module}'. Supported profile: ${required}")
    endif()
  endforeach()
  foreach(module IN LISTS required)
    if(NOT module IN_LIST modules)
      message(FATAL_ERROR "Portable project profile requires module '${module}'")
    endif()
  endforeach()
  set(header "#pragma once\n#include <string>\n#include <vector>\nnamespace nau::project {\ninline constexpr const char* StartupConfiguration = \"${startupConfiguration}\";\ninline const std::vector<std::string> SupportedComponents = {\n")
  foreach(component IN LISTS supportedComponents)
    string(APPEND header "\"${component}\",\n")
  endforeach()
  string(APPEND header "};\n}\n")
  file(WRITE "${CMAKE_BINARY_DIR}/generated/nau_project_policy.h" "${header}")
  set(NAU_PACKAGED_PROJECT_MODULES "${modules}" PARENT_SCOPE)
  set(NAU_PACKAGED_PROJECT_GAME_MODULE "${projectModule}" PARENT_SCOPE)
endfunction()
