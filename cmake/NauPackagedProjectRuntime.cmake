if(NOT NAU_RUNTIME_PROFILE STREQUAL "scene")
  message(FATAL_ERROR "The packaged project runtime requires NAU_RUNTIME_PROFILE=scene")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NauPackagedProjectDeclaration.cmake")
nau_read_packaged_project("${NAU_PACKAGED_PROJECT_DECLARATION}")
if(NAU_BROWSER_PROJECT_MODULES AND NOT NAU_BROWSER_PROJECT_MODULES STREQUAL NAU_PACKAGED_PROJECT_MODULES)
  message(FATAL_ERROR "Conflicting or unsupported browser project modules: ${NAU_BROWSER_PROJECT_MODULES}")
endif()
include("${NAU_MODULES_SOURCE_DIR}/cmake/NauMinimalRuntime.cmake")
set(NAU_PACKAGED_PROJECT_PROFILE ON)
set(NAU_BROWSER_PROJECT_PROFILE ON) # Compatibility for portable game modules.
set(NAU_FRAMEWORK_TARGET NauFrameworkScene)
set(NAU_MINIMAL_MODULE_DIRS platform_app assets scene scene_formats)
list(APPEND NAU_MINIMAL_DEPENDENCY_DIRS tinyimageformat)
list(APPEND NAU_MINIMAL_DEPENDENCY_TARGETS tinyimageformat)
include("${CMAKE_CURRENT_LIST_DIR}/NauPortableSceneSources.cmake")
if(NAU_PACKAGED_PROJECT_RUNTIME_PROFILE STREQUAL "basic-rendering-scene")
  list(APPEND NAU_MINIMAL_MODULE_DIRS assets_cpu)
  set(NAU_SCENE_CoreAssetsCpu_SOURCES
    "${NAU_MODULES_SOURCE_DIR}/modules/asset_formats/src/gltf/gltf_file.cpp"
    "${NAU_MODULES_SOURCE_DIR}/modules/asset_formats/src/gltf/gltf_mesh_accessor.cpp"
    "${NAU_MODULES_SOURCE_DIR}/modules/assets_cpu/src/cpu_mesh.cpp"
    "${NAU_MODULES_SOURCE_DIR}/modules/assets_cpu/src/cpu_texture.cpp")
  if(WIN32)
    list(APPEND NAU_MINIMAL_DEPENDENCY_DIRS binPack2D RenderDoc adl_sdk dxc ska_hash_map xxHash zstd-1.4.5 zlib-ng)
    list(APPEND NAU_MINIMAL_DEPENDENCY_TARGETS binPack2D RenderDoc adlSdk dxc ska_hash_map xxHash zstd-1.4.5 zlib-ng)
    list(APPEND NAU_MINIMAL_MODULE_DIRS render)
    option(NAU_RENDERING_CHECKPOINT "Build isolated native driver checkpoint" OFF)
  else()
    list(APPEND NAU_MINIMAL_DEPENDENCY_DIRS stb)
    list(APPEND NAU_MINIMAL_DEPENDENCY_TARGETS stb)
    list(APPEND NAU_MINIMAL_MODULE_DIRS screen_text browser_renderer)
  endif()
  list(APPEND NAU_MINIMAL_MODULE_DIRS scene_renderer)
  if("CoreInput" IN_LIST NAU_PACKAGED_PROJECT_MODULES)
    list(APPEND NAU_MINIMAL_MODULE_DIRS input)
    if(NAU_PORTABLE_INPUT_TESTS)
      set(gtest_force_shared_crt OFF CACHE BOOL "" FORCE)
      list(APPEND NAU_MINIMAL_DEPENDENCY_DIRS googletest)
      list(APPEND NAU_MINIMAL_DEPENDENCY_TARGETS gtest gmock)
    endif()
    if(WIN32)
      set(GAINPUT_BUILD_SHARED OFF CACHE BOOL "" FORCE)
      set(GAINPUT_BUILD_STATIC ON CACHE BOOL "" FORCE)
      list(APPEND NAU_MINIMAL_DEPENDENCY_DIRS gainput)
      list(APPEND NAU_MINIMAL_DEPENDENCY_TARGETS gainputstatic)
    endif()
  endif()
endif()
