cmake_minimum_required(VERSION 3.24)
file(REAL_PATH "${BUILD_ROOT}" root)
cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE OUTPUT_VARIABLE destination)
cmake_path(IS_PREFIX root "${destination}" NORMALIZE contained)
if(NOT contained OR destination STREQUAL root)
  message(FATAL_ERROR "Native delivery destination must be inside its build directory")
endif()
foreach(input "${EXECUTABLE}" "${ARCHIVE}")
  if(NOT EXISTS "${input}")
    message(FATAL_ERROR "Missing native delivery input: ${input}")
  endif()
endforeach()
file(LOCK "${BUILD_ROOT}/delivery.lock" GUARD PROCESS TIMEOUT 120)
set(staging "${destination}.staging")
if(EXISTS "${staging}" OR EXISTS "${destination}.previous")
  message(FATAL_ERROR "Inspect prior delivery staging/previous failure before removing it")
endif()
file(MAKE_DIRECTORY "${staging}")
file(COPY "${EXECUTABLE}" DESTINATION "${staging}")
file(COPY_FILE "${ARCHIVE}" "${staging}/content.nau_pack")
if(EXISTS "${destination}")
  file(RENAME "${destination}" "${destination}.previous")
endif()
file(RENAME "${staging}" "${destination}" RESULT published)
if(published)
  if(EXISTS "${destination}.previous")
    file(RENAME "${destination}.previous" "${destination}")
  endif()
  message(FATAL_ERROR "Native delivery publication failed: ${published}")
endif()
if(EXISTS "${destination}.previous")
  file(REAL_PATH "${destination}.previous" previousPath)
  cmake_path(IS_PREFIX root "${previousPath}" NORMALIZE previousContained)
  if(NOT previousContained OR previousPath STREQUAL root)
    message(FATAL_ERROR "Refusing to remove previous delivery outside build root")
  endif()
  file(REMOVE_RECURSE "${destination}.previous")
endif()
