cmake_minimum_required(VERSION 3.24)
file(REAL_PATH "${BUILD_ROOT}" root)
get_filename_component(binary "${LOADER}" DIRECTORY)
foreach(input "${LOADER}" "${binary}/${APPLICATION}.wasm" "${binary}/${APPLICATION}.data" "${INDEX}" "${SERVER}")
  if(NOT EXISTS "${input}")
    message(FATAL_ERROR "Missing browser delivery input: ${input}")
  endif()
endforeach()
cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE OUTPUT_VARIABLE destination)
cmake_path(IS_PREFIX root "${destination}" NORMALIZE contained)
if(NOT contained OR destination STREQUAL root)
  message(FATAL_ERROR "Browser delivery destination must be inside its build directory.")
endif()
file(MAKE_DIRECTORY "${destination}")
file(COPY_FILE "${LOADER}" "${destination}/${APPLICATION}.js" ONLY_IF_DIFFERENT)
file(COPY_FILE "${binary}/${APPLICATION}.wasm" "${destination}/${APPLICATION}.wasm" ONLY_IF_DIFFERENT)
file(COPY_FILE "${binary}/${APPLICATION}.data" "${destination}/${APPLICATION}.data" ONLY_IF_DIFFERENT)
file(COPY_FILE "${INDEX}" "${destination}/index.html" ONLY_IF_DIFFERENT)
file(COPY_FILE "${SERVER}" "${destination}/serve.py" ONLY_IF_DIFFERENT)
