# CMAKE_PROJECT_NauEngine_INCLUDE hook. Consumers provide their own source path.
if(NOT NAU_BROWSER_PROJECT_SOURCE_DIR OR
   NOT EXISTS "${NAU_BROWSER_PROJECT_SOURCE_DIR}/CMakeLists.txt")
  message(FATAL_ERROR "Set NAU_BROWSER_PROJECT_SOURCE_DIR to the browser project's source directory.")
endif()
file(REAL_PATH "${NAU_BROWSER_PROJECT_SOURCE_DIR}" NAU_BROWSER_PROJECT_SOURCE_DIR)
set(NAU_BROWSER_PROJECT_SOURCE_DIR "${NAU_BROWSER_PROJECT_SOURCE_DIR}" CACHE PATH "Browser project source directory" FORCE)
cmake_path(CONVERT "${NAU_EXTERNAL_PROJECT_DIRS}" TO_CMAKE_PATH_LIST NAU_EXTERNAL_PROJECT_DIRS NORMALIZE)
include("${CMAKE_CURRENT_LIST_DIR}/attach_modules.cmake")
set(NAU_EXTERNAL_RUNTIME_FILE "${CMAKE_CURRENT_LIST_DIR}/NauBrowserProjectRuntime.cmake"
  CACHE FILEPATH "Browser project runtime configuration" FORCE)
list(APPEND NAU_EXTERNAL_PROJECT_DIRS "${NAU_BROWSER_PROJECT_SOURCE_DIR}")
list(REMOVE_DUPLICATES NAU_EXTERNAL_PROJECT_DIRS)
set(NAU_EXTERNAL_PROJECT_DIRS "${NAU_EXTERNAL_PROJECT_DIRS}" CACHE STRING "Consumer projects" FORCE)
