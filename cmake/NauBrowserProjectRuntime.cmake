# Reusable CPU scene runtime for editor-created browser projects.
# Loaded by NauEngine before constructing its target graph.
if(NOT NAU_RUNTIME_PROFILE STREQUAL "scene")
  message(FATAL_ERROR "The browser project runtime requires NAU_RUNTIME_PROFILE=scene.")
endif()
include("${NAU_MODULES_SOURCE_DIR}/cmake/NauMinimalRuntime.cmake")
set(NAU_BROWSER_PROJECT_PROFILE ON)
set(NAU_FRAMEWORK_TARGET NauFrameworkScene)
set(NAU_BROWSER_PROJECT_MODULES "PlatformApp;CoreAssets;CoreScene;CoreSceneFormats"
  CACHE STRING "Required modules for non-rendering browser scene startup")
set(requiredModules PlatformApp CoreAssets CoreScene CoreSceneFormats)
foreach(module IN LISTS NAU_BROWSER_PROJECT_MODULES)
  if(NOT module IN_LIST requiredModules)
    message(FATAL_ERROR "Unsupported browser project module '${module}'. Supported profile: ${requiredModules}")
  endif()
endforeach()
foreach(module IN LISTS requiredModules)
  if(NOT module IN_LIST NAU_BROWSER_PROJECT_MODULES)
    message(FATAL_ERROR "Browser project profile requires module '${module}'.")
  endif()
endforeach()
set(NAU_MINIMAL_MODULE_DIRS platform_app assets scene scene_formats)
list(APPEND NAU_MINIMAL_DEPENDENCY_DIRS tinyimageformat)
list(APPEND NAU_MINIMAL_DEPENDENCY_TARGETS tinyimageformat)
include("${CMAKE_CURRENT_LIST_DIR}/NauPortableSceneSources.cmake")
